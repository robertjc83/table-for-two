---
// Hook this form up to your email provider (ConvertKit/Kit, Mailchimp, Beehiiv, Buttondown...)
// by setting the action URL below. Your email list is a long-term revenue asset.
const action = '#';
---
<section class="news no-print">
  <div class="inner">
    <div>
      <p class="eyebrow">The Thursday Date Night Drop</p>
      <h2>A new date night menu every week ♥</h2>
      <p>One recipe, one drink pairing, one playlist and one conversation starter, in your inbox in time to plan the weekend.</p>
    </div>
    <form method="post" action={action}>
      <label class="sr" for="nl-email">Email address</label>
      <input id="nl-email" type="email" name="email" placeholder="you@example.com" required />
      <button class="btn" type="submit">I'm in</button>
      <small>No spam, ever. Unsubscribe anytime.</small>
    </form>
  </div>
</section>
<style>
  .news { background: linear-gradient(120deg, var(--wine), #c2185b 60%, var(--coral)); color: #fff; border-radius: 32px; padding: clamp(28px, 5vw, 56px); margin: 48px 0; position: relative; overflow: hidden; }
  .news::after { content: '♥'; position: absolute; right: -20px; bottom: -70px; font-size: 18rem; opacity: .08; line-height: 1; }
  .inner { display: grid; gap: 28px; grid-template-columns: 1.2fr 1fr; align-items: center; position: relative; z-index: 1; }
  @media (max-width: 820px) { .inner { grid-template-columns: 1fr; } }
  .eyebrow { color: var(--gold); }
  h2 { color: #fff; }
  p { color: #ffe4ea; margin: 0; }
  form { display: flex; flex-wrap: wrap; gap: 10px; }
  input { flex: 1 1 220px; padding: .9em 1.2em; border-radius: 999px; border: 0; font: inherit; }
  .btn { background: var(--ink); }
  small { width: 100%; color: #ffd3dc; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
