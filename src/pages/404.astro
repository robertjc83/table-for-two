---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page went missing.">
  <section class="wrap nf">
    <span>🍳</span>
    <h1>Oops, this page got burnt.</h1>
    <p>We couldn't find what you were looking for, but dinner's still on.</p>
    <a class="btn" href="/recipes/">Browse recipes</a>
  </section>
</Base>
<style>.nf { text-align: center; padding: 100px 0; } .nf span { font-size: 6rem; } p { color: var(--muted); }</style>
