---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import PinButton from '../components/PinButton.astro';
import { COOKBOOK } from '../data/shop';
import book from '../../public/cookbook/book.json';

const { price, salePrice, buyUrl } = COOKBOOK;
const includes = [
  ['🍽️', `${book.menus.length} complete date nights`, 'From a 25-minute weeknight to a slow Sunday braise, plus Thanksgiving and Christmas Eve for two.'],
  ['⏱️', 'A game plan for every menu', 'What to make ahead and when to start each dish, so dinner is ready at the same time and nobody is stressed.'],
  ['🛒', 'Shopping lists', 'Everything for the whole menu on one page. Check it off at the store.'],
  ['👩‍🍳', 'Chef 1 / Chef 2 steps', `All ${book.recipeCount} recipes split the work so you cook together, not take turns waiting.`],
  ['🎶', 'Drinks, playlists and settings', 'The full mood for every night: what to pour, what to play, how to set the table.'],
  ['💬', 'Conversation starters', 'Three questions per menu to get you talking about more than your week.'],
];
const faqs = [
  ['What format is it?', `A ${book.pages}-page PDF in US Letter size. It looks great on a tablet, phone or laptop, and it prints beautifully.`],
  ['How do I get it?', "You'll get a download link right after checkout."],
  ['Are these recipes on the website?', 'The recipes are, and they always will be free here. The book organizes them into complete date nights and adds what the website doesn\'t have: game plans, shopping lists, conversation starters, the pantry guide and a printable planner, all in one place you can keep offline.'],
  ['Do we need to be good cooks?', 'Not at all. Most recipes are Easy or Medium, and every step says who does what.'],
];
---
<Base title="Date Night In: The E-Cookbook" description={`${book.title}: ${book.subtitle}. A ${book.pages}-page e-cookbook with menus, game plans, shopping lists, Chef 1/Chef 2 recipes and conversation starters.`}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="cover-wrap"><img class="cover" src="/cookbook/cover.jpg" alt={`${book.title} e-cookbook cover`} width="900" height="1165" /></div>
      <div>
        <p class="eyebrow">The Table for Two e-cookbook</p>
        <h1>{book.title}</h1>
        <p class="lede">{book.subtitle[0].toUpperCase() + book.subtitle.slice(1)}. Menus, game plans, shopping lists and conversation starters, all in one beautiful {book.pages}-page book.</p>
        <div class="buy">
          <div class="price">{salePrice ? <><s>{price}</s> <b>{salePrice}</b></> : <b>{price}</b>}<small>Instant PDF download</small></div>
          {buyUrl
            ? <a class="btn big" href={buyUrl} target="_blank" rel="noopener">Get the cookbook →</a>
            : <a class="btn big soon" href="#notify">Coming soon: get notified</a>}
        </div>
        <PinButton slug="cookbook" path="/cookbook/" description={`${book.title}: ${book.subtitle}. A gift for couples who love to cook together.`} variant="ghost" />
        <ul class="ticks" style="margin-top:16px"><li>{book.menus.length} date nights · {book.recipeCount} recipes</li><li>Works on any device, and prints well</li><li>Thanksgiving & Christmas menus included</li></ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">What's inside</p>
    <h2>Everything for the whole evening</h2>
    <div class="incl">{includes.map(([e, t, d]) => <div><span>{e}</span><b>{t}</b><p>{d}</p></div>)}</div>
  </section>

  <section class="peek">
    <div class="wrap">
      <p class="eyebrow">Take a peek</p>
      <h2>Inside the book</h2>
      <div class="pages">
        <figure><img src="/cookbook/preview-1.jpg" alt="Sample menu page: Steakhouse Night" loading="lazy" width="900" height="1165" /><figcaption>Each date night opens with the menu, mood and conversation starters…</figcaption></figure>
        <figure><img src="/cookbook/preview-2.jpg" alt="Sample game plan and shopping list page" loading="lazy" width="900" height="1165" /><figcaption>…then a game plan and a shopping list for the whole menu…</figcaption></figure>
        <figure><img src="/cookbook/preview-3.jpg" alt="Sample recipe page" loading="lazy" width="900" height="1165" /><figcaption>…and every recipe, with the work split between Chef 1 and Chef 2.</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">The {book.menus.length} date nights</p>
    <h2>Pick tonight's menu</h2>
    <ol class="menus">{book.menus.map((m) => <li><b>{m.title}</b><small>{m.recipes.join(' · ')}</small></li>)}</ol>
  </section>

  <section class="wrap section faq">
    <h2>Questions</h2>
    {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    <div class="final">
      <div><b>{book.title}</b><span>{salePrice || price} · instant download</span></div>
      {buyUrl ? <a class="btn big" href={buyUrl} target="_blank" rel="noopener">Get the cookbook →</a> : <a class="btn big soon" href="#notify">Get notified</a>}
    </div>
  </section>

  <div class="wrap" id="notify"><Newsletter /></div>
</Base>
<style>
  .hero { padding: clamp(40px, 7vw, 80px) 0; background: radial-gradient(ellipse at top left, #ffd9d2 0, transparent 60%), radial-gradient(ellipse at bottom right, #ffe9c7 0, transparent 55%); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .cover-wrap { max-width: 320px; margin: 0 auto; } }
  .cover { width: 100%; height: auto; border-radius: 6px 16px 16px 6px; box-shadow: -6px 0 0 #6d0b27, 0 30px 60px -20px rgba(109, 11, 39, .55); transform: rotate(-2deg); }
  .lede { font-size: 1.15rem; color: var(--muted); }
  .buy { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin: 24px 0 18px; }
  .price { display: flex; flex-direction: column; font-family: var(--display); font-size: 2.2rem; line-height: 1; }
  .price s { font-size: 1.3rem; color: var(--muted); margin-right: 6px; }
  .price small { font-family: var(--body); font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .btn.big { font-size: 1.1rem; padding: 1em 1.8em; }
  .btn.soon { background: var(--ink); }
  .ticks { list-style: none; padding: 0; margin: 0; color: var(--muted); }
  .ticks li::before { content: '♥ '; color: var(--wine); }
  .incl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 20px; }
  @media (max-width: 860px) { .incl { grid-template-columns: 1fr; } }
  .incl div { background: var(--paper); border-radius: var(--radius); padding: 22px; box-shadow: 0 1px 0 var(--line); }
  .incl span { font-size: 2rem; display: block; }
  .incl b { font-family: var(--display); font-size: 1.2rem; }
  .incl p { color: var(--muted); margin: 6px 0 0; font-size: .95rem; }
  .peek { background: var(--paper); padding: clamp(48px, 7vw, 80px) 0; }
  .pages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 24px; }
  @media (max-width: 820px) { .pages { grid-template-columns: 1fr; max-width: 380px; margin-inline: auto; } }
  .pages img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 18px 40px -18px rgba(43, 22, 33, .45); border: 1px solid var(--line); }
  figure { margin: 0; } figcaption { color: var(--muted); font-size: .9rem; margin-top: 10px; }
  .menus { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; padding-left: 0; list-style: none; counter-reset: m; margin-top: 20px; }
  .menus li { counter-increment: m; background: var(--paper); border-radius: 16px; padding: 16px 18px 16px 56px; position: relative; box-shadow: 0 1px 0 var(--line); }
  .menus li::before { content: counter(m); position: absolute; left: 16px; top: 16px; width: 28px; height: 28px; border-radius: 50%; background: var(--wine); color: #fff; display: grid; place-items: center; font-family: var(--display); font-weight: 700; font-size: .9rem; }
  .menus b { font-family: var(--display); font-size: 1.1rem; }
  .menus small { display: block; color: var(--muted); font-size: .82rem; margin-top: 2px; }
  .faq { max-width: 760px; }
  details { background: var(--paper); border-radius: 14px; padding: 16px 20px; margin-bottom: 10px; box-shadow: 0 1px 0 var(--line); }
  summary { font-weight: 700; cursor: pointer; }
  details p { margin: 10px 0 0; color: var(--muted); }
  .final { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 28px; background: var(--ink); color: #fff; border-radius: 22px; padding: 22px 26px; }
  .final b { font-family: var(--display); font-size: 1.4rem; display: block; }
  .final span { color: #cfb3bd; }
  .final .btn.soon { background: var(--wine); }
</style>
