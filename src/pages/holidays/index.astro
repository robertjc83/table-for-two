---
import Base from '../../layouts/Base.astro';
import { holidays } from '../../data/holidays';
---
<Base title="Holiday & Seasonal Date Night Recipes" description="Seasonal dinners for two: cozy fall recipes, Thanksgiving for two and a romantic Christmas Eve dinner, with full menus and plans for cooking together.">
  <section class="wrap head">
    <p class="eyebrow">Holidays & seasons</p>
    <h1>Holidays & seasons for two</h1>
    <p class="lede">Seasonal menus and holiday feasts scaled down for two, so you get all the cozy without a week of leftovers.</p>
    <div class="tiles">
      {holidays.map((h) => (
        <a class="tile" href={`/holidays/${h.slug}/`} style={`--c:${h.color}`}>
          <span>{h.emoji}</span><b>{h.title}</b><small>{h.description}</small>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .head { padding: 56px 0; }
  .lede { color: var(--muted); font-size: 1.15rem; max-width: 60ch; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 32px; }
  .tile { display: flex; flex-direction: column; gap: 8px; padding: 32px; border-radius: 28px; text-decoration: none; color: #fff; background: linear-gradient(135deg, var(--c), color-mix(in srgb, var(--c) 55%, #000)); box-shadow: var(--shadow); transition: transform .2s; }
  .tile:hover { transform: translateY(-4px); }
  .tile span { font-size: 3.4rem; }
  .tile b { font-family: var(--display); font-size: 1.7rem; }
  .tile small { color: rgba(255,255,255,.85); font-size: .95rem; }
</style>
