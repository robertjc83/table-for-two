---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import AdSlot from '../../components/AdSlot.astro';
const recipes = (await getCollection('recipes')).sort((a, b) => +b.data.published - +a.data.published);
const vibes = ['All', 'Cozy', 'Fancy', 'Playful', 'Adventurous'];
const courses = ['All', 'Starter', 'Main', 'Side', 'Dessert', 'Drink', 'Full Menu'];
---
<Base title="All Date Night Recipes" description="Browse every date night recipe for two, filtered by mood, course, time and diet. Romantic dinners and desserts you cook together at home.">
  <section class="wrap head">
    <p class="eyebrow">The recipe box</p>
    <h1>Date night recipes</h1>
    <p class="lede">Every recipe serves two, splits the work between you, and comes with a drink and a playlist.</p>

    <div class="filters" id="filters">
      <input type="search" id="q" placeholder="Search: steak, pasta, chocolate…" aria-label="Search recipes" />
      <div class="group" data-filter="vibe" aria-label="Mood">{vibes.map((v, i) => <button type="button" data-val={v} class:list={{ on: i === 0 }}>{v}</button>)}</div>
      <div class="group" data-filter="course" aria-label="Course">{courses.map((v, i) => <button type="button" data-val={v} class:list={{ on: i === 0 }}>{v}</button>)}</div>
      <div class="row">
        <label>Max time
          <select id="time"><option value="999">Any</option><option value="30">30 min</option><option value="45">45 min</option><option value="60">1 hour</option></select>
        </label>
        <label class="check"><input type="checkbox" id="veg" /> Vegetarian</label>
        <label class="check"><input type="checkbox" id="gf" /> Gluten-free</label>
      </div>
    </div>
  </section>

  <section class="wrap">
    <p class="count" id="count" aria-live="polite"></p>
    <div class="grid" id="grid">{recipes.map((r) => <RecipeCard recipe={r} />)}</div>
    <p class="empty" id="empty" hidden>No matches. Try loosening a filter or two 💔</p>
    <AdSlot size="banner" />
  </section>
</Base>

<script>
  const state = { vibe: 'All', course: 'All' };
  const cards = [...document.querySelectorAll('#grid .card')];
  const q = document.getElementById('q'), time = document.getElementById('time');
  const veg = document.getElementById('veg'), gf = document.getElementById('gf');
  const params = new URLSearchParams(location.search);
  if (params.get('vibe')) state.vibe = params.get('vibe');

  function apply() {
    document.querySelectorAll('.group').forEach((g) => g.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.val === state[g.dataset.filter])));
    const term = q.value.trim().toLowerCase();
    let n = 0;
    cards.forEach((c) => {
      const diet = c.dataset.diet;
      const show = (state.vibe === 'All' || c.dataset.vibe === state.vibe)
        && (state.course === 'All' || c.dataset.course === state.course)
        && Number(c.dataset.time) <= Number(time.value)
        && (!veg.checked || diet.includes('Vegetarian'))
        && (!gf.checked || diet.includes('Gluten-Free'))
        && (!term || c.dataset.title.includes(term) || c.textContent.toLowerCase().includes(term));
      c.style.display = show ? '' : 'none';
      if (show) n++;
    });
    document.getElementById('count').textContent = `${n} recipe${n === 1 ? '' : 's'}`;
    document.getElementById('empty').hidden = n > 0;
  }
  document.querySelectorAll('.group').forEach((g) => g.addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    state[g.dataset.filter] = b.dataset.val; apply();
  }));
  [q, time, veg, gf].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>

<style>
  .head { padding: 48px 0 24px; }
  .lede { color: var(--muted); font-size: 1.1rem; max-width: 60ch; }
  .filters { margin-top: 28px; background: var(--paper); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 14px; box-shadow: var(--shadow); }
  #q { width: 100%; padding: .85em 1.2em; border: 2px solid var(--line); border-radius: 999px; font: inherit; background: var(--cream); }
  #q:focus { border-color: var(--coral); outline: none; }
  .group { display: flex; flex-wrap: wrap; gap: 8px; }
  .group button { border: 2px solid var(--line); background: none; font: 700 .9rem var(--body); padding: .45em 1em; border-radius: 999px; cursor: pointer; color: var(--ink); }
  .group button.on { background: var(--wine); border-color: var(--wine); color: #fff; }
  .row { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; font-weight: 700; font-size: .92rem; }
  select { margin-left: 8px; font: inherit; padding: .35em .7em; border-radius: 10px; border: 2px solid var(--line); }
  .check { display: flex; gap: 6px; align-items: center; }
  .check input { accent-color: var(--wine); width: 18px; height: 18px; }
  .count { font-weight: 700; color: var(--muted); }
  .empty { text-align: center; font-size: 1.2rem; padding: 40px; }
</style>
